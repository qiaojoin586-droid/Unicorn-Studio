# 日志
# ⚠️ 必须写成锚定路径，不要改回裸 `logs/`：裸形式会匹配任意层级的同名目录，
# 已误伤过 admin/src/views/logs/（真实源码被静默排除出版本控制，
# 后果是换个 clone 后该路由的 chunk 直接加载失败）。
# 新增日志目录时在此显式补一行。
/logs/
backend/logs/
*.log

# 构建产物
backend/target/
admin/dist/
frontend/frontend/
frontend/assets/
frontend/dist/
frontend/release/
node_modules/
*.tsbuildinfo

# 数据文件与本地配置
backend/data/
data/
**/.env

# 本地开发配置（含真实凭据：DB/Redis 口令、各 JWT/crypto 密钥）—— 绝不入库
# 模板见 backend/src/main/resources/application-local.yml.example
**/application-local.yml

# 数据库迁移产物：数据导出文件含 sys_user 口令散列、AES 加密的 AI Key、
# 访客 IP 哈希等敏感数据 —— 绝不入库（结构脚本 01/03 可入库，数据脚本不可）
backend/sql/server-migration/*-data.sql
backend/sql/server-migration/_*.sql

# 系统
.DS_Store
Thumbs.db

# IDE 配置（本地个人配置，不入库）
.idea/
.vscode/

# WorkBuddy 工作区记忆与任务（本地个人，不入库）
.workbuddy/

# 忽略设计方案
# 设计方案文件夹（本地个人，不入库）
docs/

# 忽略 Docker 相关文件夹
backend/docker/