# 复制为 secrets/backend.env。不要把真实值写进示例或提交到 Git。
# 前两项使用不同的随机值，每项至少32字符，可在服务器分别执行 openssl rand -hex 32 生成。
ADMIN_JWT_SECRET=
PUBLIC_JWT_SECRET=
# 迁移已有数据库时必须保留原来的加密密钥，否则已有加密的 AI API Key 无法解密。
# 仅全新数据库才生成新的 APP_CRYPTO_SECRET。
APP_CRYPTO_SECRET=

# 将现有本地 .env 中的短信凭据复制到这里。它们不会随 JAR 打包。
REGISTRATION_SMS_PROVIDER=aliyun
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=100001
