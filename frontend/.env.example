# ============================================
# Unicorn Studio - Environment Configuration
# ============================================
# Copy this file to .env and adjust the values.
# Used by the Node.js server (dev and production).

# --- Node.js server ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# --- AI Chat (optional) ---
# Leave empty to use mock responses during development
AI_API_KEY=
