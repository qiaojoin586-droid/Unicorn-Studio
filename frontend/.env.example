# ============================================
# Unicorn Studio - Environment Configuration
# ============================================
# Copy this file to .env and adjust the values.
# Used by both Node.js dev server and SpringBoot backend.

# --- Node.js legacy server (dev only) ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# --- SpringBoot backend ---
# JWT secret (at least 32 random characters)
JWT_SECRET=replace-with-at-least-32-random-characters
# Learning page access password
LEARNING_PASSWORD=change-this-to-at-least-12-characters
# Cookie security
COOKIE_SECURE=true

# --- Session / Auth ---
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MS=28800000

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX_IPS=10000
TRUST_PROXY=true

# --- AI Chat (optional) ---
# Leave empty to use mock responses during development
AI_API_KEY=
