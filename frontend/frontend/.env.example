# ============================================
# Unicorn Studio - Environment Configuration
# ============================================
# Copy this file to .env and adjust the values.
# Used by both Node.js dev server and SpringBoot backend.

# --- Node.js server ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# --- SpringBoot backend ---
# JWT secret (at least 32 random characters)
JWT_SECRET=replace-with-at-least-32-random-characters

# --- AI Chat (optional) ---
# Leave empty to use mock responses during development
AI_API_KEY=
