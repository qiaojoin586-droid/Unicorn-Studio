# ============================================
# Unicorn Studio - Environment Configuration
# ============================================
# Copy this file to .env and adjust the values.
# Used by the Node.js server (dev and production).

# --- Node.js server ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Java 后端地址：Node 将 /api/* 反向代理到此处（默认本机 8080）
# API_PROXY_TARGET=http://127.0.0.1:8080
# 开发环境逃生开关：USE_MOCK_API=1 时学习资料走本地 mock（仅非生产环境生效）
# USE_MOCK_API=0

# --- AI Chat ---
# AI_API_KEY 配置在 Java 后端（backend 环境变量），前端不接触密钥。
# 后端未配置 key 时：dev profile 走 mock 流式响应；生产返回 503。
