<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

<!--    每次更新前要更新版本号   -->
    <groupId>com.unicorn</groupId>
    <artifactId>unicorn-studio</artifactId>
    <version>1.0.1</version>
    <name>Unicorn Studio Backend</name>
    <description>Unicorn Studio backend service</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring AI 版本：1.0.x 对齐 Spring Boot 3.3.x（2.0.x 需要 Spring Boot 4.x） -->
        <spring-ai.version>1.0.9</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          运维可观测性（B-19）：/actuator/metrics 暴露 JVM 堆/GC/线程与连接池指标，
          /actuator/threaddump 用于排查线程池问题。
          这是本次优化的【前置条件】—— 没有它，B-17（堆峰值）、B-04（线程池）、
          B-06（连接池）的改动收益无法量化，只能靠感觉，回归时也发现不了劣化。
          ⚠️ 暴露面必须按 application.yml 的 management 段与 ActuatorSecurityConfig 落实：
          独立端口 + 仅回环 + 默认不暴露 heapdump（堆里驻留着已解密的明文 API Key）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Database -->
        <!-- MyBatis Plus（boot3 starter，jakarta 兼容） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.9</version>
        </dependency>
        <!-- 3.5.9 起分页插件移入独立构件（PaginationInnerInterceptor） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.9</version>
        </dependency>
        <!-- Druid 连接池 + SQL 统计（boot3 starter，jakarta 兼容） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>1.2.28</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis 服务（V15 缓存方案：StringRedisTemplate + 显式 ObjectMapper） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池（commons-pool2，版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>


        <!-- JWT（后台管理 token） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 富文本消毒（jsoup 白名单） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>

        <!-- 限流：自 V15 迁至 Redis（common/cache/RedisRateLimiter，Lua INCR+EXPIRE），
             原 bucket4j-core 内存版已移除（§4.5） -->

        <!-- AOP（审计切面 / 异步） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 邮件通知（留言回复可选） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== Spring AI（AIWorker 模块） ====================
             OpenAI 兼容协议 starter：同时支持 OpenAI 官方与各类兼容网关
             （如 DeepSeek / 通义 / 智谱 / OneAPI 等，只需替换 base-url 与 model）。
             ChatClient/工具调用（Function Calling）均由 Spring AI 提供。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Mockito 内联 mock maker 需要 Byte Buddy 以【Java agent】形式挂载。

                为什么必须显式配：Mockito 会先尝试「自附加（self-attach）」，即在测试 JVM 里
                另起一个进程去 attach 自己。这条路在很多环境下不通（JDK 21 已把动态 attach 标为
                弃用并默认告警，且沙箱/受限环境直接失败），报错是：

                    MockitoInitializationException:
                    It appears as if your JDK does not supply a working agent attachment mechanism.
                    Caused by: Could not self-attach to current VM using external process

                后果是**所有**用 @Mock/MockitoExtension 的测试整体报
                "Could not initialize plugin: interface org.mockito.plugins.MockMaker" ——
                看着像测试写错了，其实是运行环境缺 agent，极易误判。
                （IDEA 自己的测试运行器会替你挂上 agent，所以同一套代码在 IDE 里绿、在
                 mvn 命令行里红 —— 这正是本项目遇到的情形。）

                修法就是 Maven 官方推荐的两步：
                  ① dependency-plugin 把 byte-buddy-agent 的 jar 绝对路径解析进 ${argLine}；
                  ② surefire 把 -javaagent:... 传给测试 JVM。
                只影响 test 阶段，不影响打出来的 jar。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-byte-buddy-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{...} 是 surefire 的延迟求值语法，用于引用本插件之外产生的属性 -->
                    <argLine>-javaagent:@{net.bytebuddy:byte-buddy-agent:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      打包专用 profile：保证 jar 内只有 src/main/resources/application.yml 这一个 yaml。

      为什么需要：
        · Spring Boot 只把 `application.yml` 当作主配置自动加载，所以服务器要「零外部配置」，
          这个文件名不能改；
        · 本地开发可能重新放一份 `application-local.yml`（已 gitignore）。它绝不能被带进 jar，
          否则服务器上会出现「两份配置叠加」的隐式行为（profile 文件优先级高于主配置）。

      用法：
        mvn -Pjar clean package -DskipTests
        java -jar target/unicorn-studio-1.0.0.jar
    -->
    <profiles>
        <profile>
            <id>jar</id>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <filtering>false</filtering>
                        <excludes>
                            <exclude>application-*.yml</exclude>
                            <exclude>application-*.yaml</exclude>
                        </excludes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
